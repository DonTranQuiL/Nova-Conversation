{
  "title": "Nova Conversation",
  "config": {
    "step": {
      "user": {
        "title": "Nova: Connect your AI",
        "data": {
          "api_key": "[%key:common::config_flow::data::api_key%]",
          "base_url": "Base URL (e.g. OpenRouter, LM Studio)"
        }
      }
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    }
  },
  "options": {
    "step": {
      "init": {
        "data": {
          "prompt": "Instructions",
          "chat_model": "AI Model",
          "max_tokens": "Maximum tokens to return",
          "temperature": "Temperature (Creativity)",
          "top_p": "Top P",
          "llm_hass_api": "Control Home Assistant (LLM API)",
          "recommended": "Use recommended model settings",
          "base_url": "API Base URL",
          "enable_tools": "Enable Smart Home Tools"
        },
        "data_description": {
          "prompt": "Instruct how the Nova AI should respond. You can use templates here."
        }
      }
    }
  },
  "services": {
    "generate_image": {
      "name": "Nova: Generate Image",
      "description": "Use Nova to turn a text prompt into an image",
      "fields": {
        "config_entry": {
          "name": "Config Entry",
          "description": "Select the Nova instance to use"
        },
        "prompt": {
          "name": "Prompt",
          "description": "What should Nova create?",
          "example": "A futuristic smart home in the mountains"
        },
        "size": {
          "name": "Size",
          "description": "Resolution of the image"
        },
        "quality": {
          "name": "Quality",
          "description": "Standard or High Definition"
        },
        "style": {
          "name": "Style",
          "description": "Vivid or Natural style"
        }
      }
    }
  },
  "exceptions": {
    "invalid_config_entry": {
      "message": "Invalid Nova config entry provided. Got {config_entry}"
    }
  }
}
